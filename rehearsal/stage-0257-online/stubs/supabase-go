#!/bin/bash
# TEST STUB of supabase-go (CI only): behaviour comes from $HOME/stubcfg (key=value), never from the environment. Logs every call to $HOME/calls.log.
H=$HOME; CFG=$H/stubcfg
cfg() { sed -n "s/^$1=//p" "$CFG" 2>/dev/null | head -1; }
CANARY_TOK=canary-token-4f1c; CANARY_PW=canary-pw-9d2e
args="$*"
case "$args" in *"$CANARY_PW"*|*"$CANARY_TOK"*) echo "LEAK argv" >> "$H/leak.log" ;; esac
case "$args" in *--include-all*) echo "LEAK include-all" >> "$H/leak.log"; echo "stub: --include-all is forbidden in the 0257-only stage" >&2; exit 2 ;; esac
hang() { : > "$H/$1"; i=0; while [ $i -lt 300 ]; do sleep 0.2; i=$((i+1)); done; exit 9; }
if [ "${1:-}" = --agent ] && [ "${4:-}" = query ]; then # the runner's call: --agent no db query --linked -o json -f FILE
  f=""; while [ $# -gt 0 ]; do [ "$1" = -f ] && f=$2; shift; done
  b=$(basename "$f" .sql)
  printf 'query:%s sql=%s\n' "$b" "$(shasum -a 256 "$f" | cut -d' ' -f1)" >> "$H/calls.log"
  if [ "${SUPABASE_ACCESS_TOKEN:-}" != "$CANARY_TOK" ] || [ "${SUPABASE_DB_PASSWORD:-}" != "$CANARY_PW" ]; then echo "401 unauthorized" >&2; exit 1; fi
  [ "$(cfg READ_AUTH)" = fail ] && { echo "failed to connect: SASL auth failed (28P01)" >&2; exit 1; }
  [ "$(cfg QUERY_HANG)" = "$b" ] && hang query-started
  [ "$(cfg FAIL)" = "$b" ] && { echo "ERROR: relation does not exist (42P01)" >&2; exit 1; }
  v=$(cfg "V_$b")
  case "$b" in
    g02-history-0257)
      case "$v" in count247) echo '[{"applied_count":247,"hosted_max":"0248","versions_ge_0249":0,"rows_0246":1,"rows_0248":1,"last4":"0248,0246,0245,0244"}]' ;;
        max0249) echo '[{"applied_count":246,"hosted_max":"0249","versions_ge_0249":1,"rows_0246":1,"rows_0248":1,"last4":"0249,0248,0246,0245"}]' ;;
        ge0249) echo '[{"applied_count":246,"hosted_max":"0248","versions_ge_0249":1,"rows_0246":1,"rows_0248":1,"last4":"0248,0246,0245,0244"}]' ;;
        applied) echo '[{"applied_count":247,"hosted_max":"0257","versions_ge_0249":1,"rows_0246":1,"rows_0248":1,"last4":"0257,0248,0246,0245"}]' ;;
        *) echo '[{"applied_count":"246","hosted_max":"0248","versions_ge_0249":"0","rows_0246":1,"rows_0248":1,"last4":"0248,0246,0245,0244"}]' ;; esac ;;
    g12-0257-preflight-0257)
      case "$v" in bad) echo '[{"at_hosted_0248":1,"tables_present":false,"helpers_ok":true,"v1_ok":true,"attempt_columns_ok":true,"new_objects_absent":true}]' ;;
        newobj) echo '[{"at_hosted_0248":1,"tables_present":true,"helpers_ok":true,"v1_ok":true,"attempt_columns_ok":true,"new_objects_absent":false}]' ;;
        *) echo '[{"at_hosted_0248":1,"tables_present":true,"helpers_ok":true,"v1_ok":true,"attempt_columns_ok":true,"new_objects_absent":true}]' ;; esac ;;
    s1-open-transactions-0257)
      x=studio_payment_jurisdiction_changes; o=0; p=true
      [ "$v" = old ] && o=1
      [ "$v" = absent ] && p=false
      [ "$v" = other ] && x=studio_payment_jurisdiction_other
      printf '[{"at_hosted_0248":1,"table_name":"%s","table_present":%s,"old_xact_backends":%s,"old_idle_in_xact_backends":0,"waiting_backends":0,"any_xact_backends":0,"oldest_xact_age_seconds":0,"old_xact_backends_database_wide":0}]\n' "$x" "$p" "$o" ;;
    w03-table-sizes-0257)
      st=$(cfg ST); [ -n "$st" ] || st=2min
      x=studio_payment_jurisdiction_changes; b2=1048576
      [ "$v" = big ] && b2=629145600
      [ "$v" = other ] && x=studio_payment_jurisdiction_other
      row() { printf '{"at_hosted_0248":1,"table_name":"%s","present":true,"total_bytes":%s,"approx_rows":10,"statement_timeout":"%s","lock_timeout":"0"}' "$1" "$2" "$3"; }
      if [ "$v" = dup ]; then printf '[%s,%s]\n' "$(row $x $b2 $st)" "$(row $x $b2 30s)"; else printf '[%s]\n' "$(row $x $b2 $st)"; fi ;;
    *) echo "unknown query $b" >&2; exit 1 ;;
  esac
  exit 0
fi
if [ "${1:-}" = db ] && [ "${2:-}" = push ]; then
  mode=push; case "$args" in *--dry-run*) mode=dry ;; esac
  printf '%s\n' "$mode" >> "$H/calls.log"
  [ -z "${SUPABASE_ACCESS_TOKEN:-}" ] || echo "LEAK token-in-env $mode" >> "$H/leak.log"
  [ "${PGPASSWORD:-}" = "$CANARY_PW" ] || { echo "password authentication failed (28P01)" >&2; exit 1; }
  if [ "$mode" = dry ]; then
    case "$(cfg DRY)" in authfail) echo "failed SASL auth: password authentication failed (28P01)" >&2; exit 1 ;; esac
    echo 'DRY RUN: migrations will *not* be pushed to the database.'; echo 'Would push these migrations:'
    case "$(cfg DRY)" in two) echo ' • 0257_studio_payment_jurisdiction_failed_attempt_ack.sql'; echo ' • 0249_x.sql' ;; wrong) echo ' • 0247_x.sql' ;; *) echo ' • 0257_studio_payment_jurisdiction_failed_attempt_ack.sql' ;; esac
    exit 0
  fi
  case "$(cfg PUSH)" in
    authfail) echo "failed SASL auth: password authentication failed (28P01)" >&2; exit 1 ;;
    fail) echo "ERROR: statement failed (XX000)" >&2; exit 1 ;;
    killed) echo "Applying migration 0257_studio_payment_jurisdiction_failed_attempt_ack.sql..."; kill -9 $$ ;;
    hang) echo "Applying migration 0257_studio_payment_jurisdiction_failed_attempt_ack.sql..."; hang push-started ;;
    two) echo "Applying migration 0257_studio_payment_jurisdiction_failed_attempt_ack.sql..."; echo "Applying migration 0249_x.sql..."; echo "Finished supabase db push."; exit 0 ;;
    nofinish) echo "Applying migration 0257_studio_payment_jurisdiction_failed_attempt_ack.sql..."; exit 0 ;;
    *) echo "Applying migration 0257_studio_payment_jurisdiction_failed_attempt_ack.sql..."; echo "Finished supabase db push."; exit 0 ;;
  esac
fi
echo "stub: unexpected call: $args" >&2; echo "UNEXPECTED $args" >> "$H/leak.log"; exit 2
