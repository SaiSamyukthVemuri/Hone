
const cmp = (got, want, what) => { if (JSON.stringify([...got].sort()) !== JSON.stringify([...want].sort())) fail(`${what}: got ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`); };
const tb = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}|${isTrue(x.rls)}`);
const fnr = (name) => rows(name).map((x) => `${x.obj}(${x.args})|definer=${isTrue(x.definer)}|sp=${x.search_path}|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const fnx = (name) => rows(name).map((x) => `${x.obj}(${x.args})|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const plx = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}`);
const pl = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}|${x.roles}`);
const sq = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}`);
const tg = (name) => rows(name).map((x) => `${x.obj}|${x.tgname}|${x.enabled}|row=${isTrue(x.row_level)}|before=${isTrue(x.before_trg)}`);
cmp(pl("c01_realtime_policies"), ["messages|schedule_signal_member_read|SELECT|PERMISSIVE|authenticated", "messages|schedule_signal_no_client_insert|INSERT|RESTRICTIVE|anon,authenticated"], "realtime.messages: exactly schedule_signal_member_read (SELECT, authenticated) and schedule_signal_no_client_insert (RESTRICTIVE INSERT, anon and authenticated)");
console.log("PASS realtime.messages: exactly schedule_signal_member_read (SELECT, authenticated) and schedule_signal_no_client_insert (RESTRICTIVE INSERT, anon and authenticated)");
cmp(fnr("c02_realtime_facts"), ["send(jsonb, text, text, boolean)|definer=false|sp=|exec=anon,authenticated,service_role|public=true"], "realtime.messages: RLS enabled, INSERT held by anon and authenticated (the recorded hosted shape), bypassrls held by neither, realtime.send executable by the three roles and SECURITY INVOKER");
console.log("PASS realtime.messages: RLS enabled, INSERT held by anon and authenticated (the recorded hosted shape), bypassrls held by neither, realtime.send executable by the three roles and SECURITY INVOKER");
cmp(tg("c03_triggers"), ["appointments|appointments_schedule_signal_ins_trg|O|row=false|before=false", "appointments|appointments_schedule_signal_upd_trg|O|row=false|before=false", "appointments|appointments_schedule_signal_del_trg|O|row=false|before=false", "studio_timed_blocks|studio_timed_blocks_schedule_signal_ins_trg|O|row=false|before=false", "studio_timed_blocks|studio_timed_blocks_schedule_signal_upd_trg|O|row=false|before=false", "studio_timed_blocks|studio_timed_blocks_schedule_signal_del_trg|O|row=false|before=false", "studio_blockouts|studio_blockouts_schedule_signal_ins_trg|O|row=false|before=false", "studio_blockouts|studio_blockouts_schedule_signal_upd_trg|O|row=false|before=false", "studio_blockouts|studio_blockouts_schedule_signal_del_trg|O|row=false|before=false", "studio_recurring_break_occurrences|studio_recurring_break_occurrences_schedule_signal_ins_trg|O|row=false|before=false", "studio_recurring_break_occurrences|studio_recurring_break_occurrences_schedule_signal_upd_trg|O|row=false|before=false", "studio_recurring_break_occurrences|studio_recurring_break_occurrences_schedule_signal_del_trg|O|row=false|before=false"], "the twelve schedule-signal triggers are present, enabled, statement level, after");
console.log("PASS the twelve schedule-signal triggers are present, enabled, statement level, after");
cmp(fnr("c04_functions"), ["emit_schedule_signal()|definer=true|sp=pg_catalog, pg_temp|exec=|public=false", "schedule_signal_send(uuid)|definer=true|sp=pg_catalog, pg_temp|exec=|public=false"], "the emitter functions are executable by nobody (no PUBLIC, anon, authenticated or service_role) and run with a pinned search_path");
