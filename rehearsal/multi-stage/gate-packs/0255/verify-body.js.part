
const cmp = (got, want, what) => { if (JSON.stringify([...got].sort()) !== JSON.stringify([...want].sort())) fail(`${what}: got ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`); };
const tb = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}|${isTrue(x.rls)}`);
const fnr = (name) => rows(name).map((x) => `${x.obj}(${x.args})|definer=${isTrue(x.definer)}|sp=${x.search_path}|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const fnx = (name) => rows(name).map((x) => `${x.obj}(${x.args})|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const plx = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}`);
const pl = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}|${x.roles}`);
const sq = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}`);
const kv = (name) => rows(name).map((x) => `${x.k}=${x.v}`);
const fnr3 = (name) => rows(name).map((x) => `${x.obj}(${x.args})|definer=${isTrue(x.definer)}|sp=${x.search_path}`);
const tg = (name) => rows(name).map((x) => `${x.obj}|${x.tgname}|${x.enabled}|row=${isTrue(x.row_level)}|before=${isTrue(x.before_trg)}`);
cmp(kv("c01_browser_privs"), ["waitlist.anon.select=false", "waitlist.anon.insert=true", "waitlist.anon.update=false", "waitlist.anon.delete=false", "waitlist.anon.truncate=false", "waitlist.anon.references=false", "waitlist.anon.trigger=false", "waitlist.anon.col_select=false", "waitlist.anon.col_update=false", "waitlist.authenticated.select=false", "waitlist.authenticated.insert=true", "waitlist.authenticated.update=false", "waitlist.authenticated.delete=false", "waitlist.authenticated.truncate=false", "waitlist.authenticated.references=false", "waitlist.authenticated.trigger=false", "waitlist.authenticated.col_select=false", "waitlist.authenticated.col_update=false", "demo_requests.anon.select=false", "demo_requests.anon.insert=true", "demo_requests.anon.update=false", "demo_requests.anon.delete=false", "demo_requests.anon.truncate=false", "demo_requests.anon.references=false", "demo_requests.anon.trigger=false", "demo_requests.anon.col_select=false", "demo_requests.anon.col_update=false", "demo_requests.authenticated.select=false", "demo_requests.authenticated.insert=true", "demo_requests.authenticated.update=false", "demo_requests.authenticated.delete=false", "demo_requests.authenticated.truncate=false", "demo_requests.authenticated.references=false", "demo_requests.authenticated.trigger=false", "demo_requests.authenticated.col_select=false", "demo_requests.authenticated.col_update=false"], "waitlist and demo_requests: anon and authenticated hold INSERT only (no SELECT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER, no column privilege)");
console.log("PASS waitlist and demo_requests: anon and authenticated hold INSERT only (no SELECT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER, no column privilege)");
cmp(kv("c02_service_role"), ["waitlist.service_role.select=true", "demo_requests.service_role.select=true"], "service_role still reads both tables (the admin console)");
console.log("PASS service_role still reads both tables (the admin console)");
cmp(pl("c03_policies"), ["waitlist|waitlist_anonymous_insert|INSERT|PERMISSIVE|anon,authenticated", "demo_requests|demo_requests_anonymous_insert|INSERT|PERMISSIVE|anon,authenticated"], "each table has exactly one INSERT-capable policy, the bounded one, for anon and authenticated, and no read/update/delete/all policy");
console.log("PASS each table has exactly one INSERT-capable policy, the bounded one, for anon and authenticated, and no read/update/delete/all policy");
cmp(kv("c04_constraints"), ["waitlist_email_format_chk=validated:false", "waitlist_field_length_chk=validated:false", "demo_requests_email_format_chk=validated:false", "demo_requests_field_length_chk=validated:false"], "the four form CHECK constraints exist and are NOT VALID (VALIDATE is not part of this stage)");
console.log("PASS the four form CHECK constraints exist and are NOT VALID (VALIDATE is not part of this stage)");
cmp(fnr3("c05_invoker_fns"), ["set_updated_at()|definer=false|sp=pg_catalog, pg_temp", "reject_payment_consents_mutation()|definer=false|sp=pg_catalog, pg_temp", "reject_payment_audit_mutation()|definer=false|sp=pg_catalog, pg_temp", "set_updated_at_now()|definer=false|sp=pg_catalog, pg_temp", "treatment_plan_stages_set_studio_id()|definer=false|sp=pg_catalog, pg_temp", "client_personal_notes_set_studio_id()|definer=false|sp=pg_catalog, pg_temp", "tg_client_portal_messages_set_updated_at()|definer=false|sp=pg_catalog, pg_temp", "tg_client_portal_message_replies_set_updated_at()|definer=false|sp=pg_catalog, pg_temp", "tg_consent_form_templates_set_updated_at()|definer=false|sp=pg_catalog, pg_temp", "tg_client_payment_methods_set_updated_at()|definer=false|sp=pg_catalog, pg_temp", "payment_charge_attempts_touch_updated_at()|definer=false|sp=pg_catalog, pg_temp", "enforce_treatment_image_integrity()|definer=false|sp=pg_catalog, pg_temp", "tg_studio_tracking_providers_set_updated_at()|definer=false|sp=pg_catalog, pg_temp"], "the 13 invoker functions pin search_path to pg_catalog, pg_temp");
console.log("PASS the 13 invoker functions pin search_path to pg_catalog, pg_temp");
cmp(fnx("c06_exec"), ["snapshot_appointment_buffer()|exec=|public=false", "handle_new_user()|exec=|public=false", "enforce_appointment_buffer()|exec=|public=false", "guard_scoped_recurring_rule_capacity()|exec=|public=false", "studios_admission_mode_guard()|exec=|public=false", "is_studio_member(uuid)|exec=authenticated|public=false", "is_studio_owner(uuid)|exec=authenticated|public=false", "session_is_visible(uuid)|exec=authenticated|public=false"], "the 5 trigger-only functions are executable by neither anon nor authenticated, and not by PUBLIC; the 3 RLS predicates are executable by authenticated and not by anon or PUBLIC");
console.log("PASS the 5 trigger-only functions are executable by neither anon nor authenticated, and not by PUBLIC; the 3 RLS predicates are executable by authenticated and not by anon or PUBLIC");
cmp(kv("c07_anon_predicate_policies"), ["anon_predicate_policies=0"], "no policy in public applies to anon or PUBLIC and calls an RLS predicate");
console.log("PASS no policy in public applies to anon or PUBLIC and calls an RLS predicate");
