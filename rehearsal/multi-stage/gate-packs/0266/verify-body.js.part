
const cmp = (got, want, what) => { if (JSON.stringify([...got].sort()) !== JSON.stringify([...want].sort())) fail(`${what}: got ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`); };
const tb = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}|${isTrue(x.rls)}`);
const fnr = (name) => rows(name).map((x) => `${x.obj}(${x.args})|definer=${isTrue(x.definer)}|sp=${x.search_path}|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const fnx = (name) => rows(name).map((x) => `${x.obj}(${x.args})|exec=${x.exec_roles}|public=${isTrue(x.exec_public)}`);
const plx = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}`);
const pl = (name) => rows(name).map((x) => `${x.obj}|${x.policyname}|${x.cmd}|${x.permissive}|${x.roles}`);
const sq = (name) => rows(name).map((x) => `${x.obj}|${x.role}|${x.privs}`);
const kv = (name) => rows(name).map((x) => `${x.k}=${x.v}`);
const fnr3 = (name) => rows(name).map((x) => `${x.obj}(${x.args})|definer=${isTrue(x.definer)}|sp=${x.search_path}`);
const tg = (name) => rows(name).map((x) => `${x.obj}|${x.tgname}|${x.enabled}|row=${isTrue(x.row_level)}|before=${isTrue(x.before_trg)}`);
cmp(tb("c01_new_tables"), ["studio_legal_name_access|anon||true", "studio_legal_name_access|authenticated|select|true", "studio_legal_name_access|service_role||true", "client_legal_name_access_audit|anon||true", "client_legal_name_access_audit|authenticated|select|true", "client_legal_name_access_audit|service_role||true"], "the two new tables: authenticated holds SELECT only; anon and service_role hold nothing; RLS on");
console.log("PASS the two new tables: authenticated holds SELECT only; anon and service_role hold nothing; RLS on");
cmp(tb("c02_identity_table"), ["client_legal_identities|anon||true", "client_legal_identities|authenticated|select,insert,update|true", "client_legal_identities|service_role||true"], "client_legal_identities: no DELETE grant for any role; service_role denied");
console.log("PASS client_legal_identities: no DELETE grant for any role; service_role denied");
cmp(pl("c03_policies"), ["client_legal_identities|client_legal_identities_insert|INSERT|PERMISSIVE|authenticated", "client_legal_identities|client_legal_identities_select|SELECT|PERMISSIVE|authenticated", "client_legal_identities|client_legal_identities_update|UPDATE|PERMISSIVE|authenticated", "client_legal_name_access_audit|client_legal_name_access_audit_select|SELECT|PERMISSIVE|authenticated", "studio_legal_name_access|studio_legal_name_access_select|SELECT|PERMISSIVE|authenticated"], "policies: both new tables have only a SELECT policy (no INSERT, UPDATE, DELETE or ALL); client_legal_identities has no DELETE or ALL policy");
console.log("PASS policies: both new tables have only a SELECT policy (no INSERT, UPDATE, DELETE or ALL); client_legal_identities has no DELETE or ALL policy");
cmp(fnx("c04_functions"), ["can_read_client_legal_identity(uuid)|exec=authenticated|public=false", "client_legal_name_access_audit_immutable()|exec=|public=false", "receptionist_calendar(uuid, timestamp with time zone, timestamp with time zone)|exec=authenticated|public=false", "receptionist_client_contacts(uuid, text, integer)|exec=|public=false", "receptionist_client_contacts_v2(uuid, text, integer)|exec=authenticated|public=false", "set_receptionist_legal_name_access(uuid, boolean)|exec=authenticated|public=false"], "functions: the new and replaced functions are executable by authenticated only (the old receptionist_client_contacts and the audit trigger function by nobody), no PUBLIC grant");
console.log("PASS functions: the new and replaced functions are executable by authenticated only (the old receptionist_client_contacts and the audit trigger function by nobody), no PUBLIC grant");
cmp(fnr("c06_definer_facts"), ["set_receptionist_legal_name_access(uuid, boolean)|definer=true|sp=pg_catalog, pg_temp|exec=authenticated|public=false", "can_read_client_legal_identity(uuid)|definer=true|sp=pg_catalog, pg_temp|exec=authenticated|public=false", "receptionist_client_contacts_v2(uuid, text, integer)|definer=true|sp=pg_catalog, pg_temp|exec=authenticated|public=false", "receptionist_calendar(uuid, timestamp with time zone, timestamp with time zone)|definer=true|sp=pg_catalog, pg_temp|exec=authenticated|public=false", "client_legal_name_access_audit_immutable()|definer=false|sp=pg_catalog, pg_temp|exec=|public=false"], "every 0266 function pins search_path to pg_catalog, pg_temp (Privacy G1); the writer, predicate, v2 contacts and calendar are definers, the audit trigger function is an invoker");
console.log("PASS every 0266 function pins search_path to pg_catalog, pg_temp (Privacy G1); the writer, predicate, v2 contacts and calendar are definers, the audit trigger function is an invoker");
cmp(sq("c07_audit_sequence"), ["client_legal_name_access_audit_id_seq|anon|", "client_legal_name_access_audit_id_seq|authenticated|", "client_legal_name_access_audit_id_seq|service_role|"], "the audit identity sequence is granted to NO API role (Privacy G6)");
console.log("PASS the audit identity sequence is granted to NO API role (Privacy G6)");
cmp(tg("c05_triggers"), ["client_legal_name_access_audit|client_legal_name_access_audit_no_truncate|O|row=false|before=true", "client_legal_name_access_audit|client_legal_name_access_audit_no_update|O|row=true|before=true"], "the audit table's append-only triggers are present and enabled");
console.log("PASS the audit table's append-only triggers are present and enabled");
