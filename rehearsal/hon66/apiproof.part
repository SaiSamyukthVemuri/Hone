# REHEARSAL - NEVER MERGE. HON66 H6 (Insurance): what the pinned CLI sends over HTTP, observed through a local recording fake Management API
# (mitmproxy answers every api.supabase.com request itself; nothing leaves the runner). Canary credentials generated at run time.
say "== H6. recorded requests: db push --db-url sends none; reads hit only the expected endpoints"
python3 -m venv "$OUT/venv" > /dev/null 2>&1 && "$OUT/venv/bin/pip" install --quiet "mitmproxy==11.0.2" > "$OUT/pip.log" 2>&1 || { tail -n 5 "$OUT/pip.log"; say "FAIL mitmproxy install"; }
MITM="$OUT/mitm"; mkdir -p "$MITM"
cat > "$MITM/fakeapi.py" <<'PY'
import json, os, re
from mitmproxy import http
OUT = os.environ["MITM_OUT"]
class Fake:
    def request(self, flow: http.HTTPFlow):
        r = flow.request
        with open(OUT, "a") as f:
            f.write(json.dumps({"method": r.method, "host": r.pretty_host, "path": r.path.split("?")[0], "has_auth": "authorization" in r.headers}) + "\n")
        p = r.path.split("?")[0]
        if r.method == "POST" and re.fullmatch(r"/v1/projects/[a-z]+/database/query", p):
            flow.response = http.Response.make(201, json.dumps([{"one": 1}]), {"Content-Type": "application/json"})
        elif r.method == "GET" and re.fullmatch(r"/v1/projects/[a-z]+/database/backups", p):
            flow.response = http.Response.make(200, json.dumps({"region": "x", "walg_enabled": True, "pitr_enabled": True, "backups": [], "physical_backup_data": {}}), {"Content-Type": "application/json"})
        else:
            flow.response = http.Response.make(404, json.dumps({"message": "fake api: not found"}), {"Content-Type": "application/json"})
addons = [Fake()]
PY
PORTP=8089
with_fake_api() { # with_fake_api <label> <command...>
  local label="$1"; shift
  : > "$OUT/flows-$label.jsonl"
  MITM_OUT="$OUT/flows-$label.jsonl" "$OUT/venv/bin/mitmdump" -q -p "$PORTP" --set confdir="$MITM" -s "$MITM/fakeapi.py" > "$OUT/mitm-$label.log" 2>&1 &
  local pid=$!
  for _ in $(seq 1 40); do [ -f "$MITM/mitmproxy-ca-cert.pem" ] && (echo > /dev/tcp/127.0.0.1/$PORTP) 2> /dev/null && break; sleep 0.5; done
  env HTTPS_PROXY="http://127.0.0.1:$PORTP" HTTP_PROXY="http://127.0.0.1:$PORTP" NO_PROXY="" SSL_CERT_FILE="$MITM/mitmproxy-ca-cert.pem" "$@"
  local rc=$?
  sleep 1; kill "$pid" 2> /dev/null; wait "$pid" 2> /dev/null
  return $rc
}
flows() { sed 's/^/   | /' "$OUT/flows-$1.jsonl"; }
nflows() { local n; n="$(grep -c . "$OUT/flows-$1.jsonl" 2> /dev/null)"; echo "${n:-0}"; }
FAKEREF=abcdefghijklmnopqrst
FAKETOKEN="sbp_$(openssl rand -hex 20)"
mklinked() { # mklinked <dir> : a linked dir like the reviewed wrappers write (no config.toml)
  rm -rf "$1"; mkdir -p "$1/supabase/.temp" "$1/supabase/migrations"
  printf '%s\n' "$FAKEREF" > "$1/supabase/.temp/project-ref"
  printf '%s' "postgresql://postgres.$FAKEREF@$RUNNER_IP:$TLSP/postgres" > "$1/supabase/.temp/pooler-url"
  cp "$OUT/cli-latest" "$1/supabase/.temp/cli-latest"
}
# the hosted direct host is AAAA-only; the CLI falls back to supabase/.temp/pooler-url only when the direct dial fails with a network error
# (not on NXDOMAIN). An unroutable IPv6 address for the fake ref's host reproduces that on this IPv4-only runner (no packet leaves the machine).
echo "2001:db8::1 db.$FAKEREF.supabase.co" | sudo tee -a /etc/hosts > /dev/null
clean_hon66
# 1. db push --db-url (the S1 apply form): password in PGPASSWORD, no token. A dry run and a real push of ONE small file.
A1="$OUT/api-push"; mkwd "$A1"; cat > "$A1/supabase/migrations/0213_hon66_api.sql" <<'SQL'
create table public.hon66_api (id int);
SQL
with_fake_api push env -u GITHUB_TOKEN -u GH_TOKEN "${S1ENV[@]}" PGPASSWORD="$PWU" bash -c "cd '$A1' && '$GOBIN' db push --db-url '$TLSURL_BASE' --dry-run > '$OUT/api-push-dry.log' 2>&1; echo \$? > '$OUT/api-push-dry.rc'; '$GOBIN' db push --db-url '$TLSURL_BASE' --yes > '$OUT/api-push-real.log' 2>&1; echo \$? > '$OUT/api-push-real.rc'"
say "RESULT db push --db-url dry run exit=$(cat "$OUT/api-push-dry.rc") push exit=$(cat "$OUT/api-push-real.rc"); HTTP requests seen: $(nflows push)"; flows push | tee -a "$RES"
expect "(H6a) db push --db-url (dry run + real push, no token) sends NO HTTP request" "$([ "$(nflows push)" = 0 ] && [ "$(cat "$OUT/api-push-real.rc")" = 0 ] && [ "$(hist_n)" = 1 ] && echo 0 || echo 1)" "requests=$(nflows push) pushed=$(hist_n)"
clean_hon66
# 2. db push --linked with a password and NO token (dry run only): no login-role POST, no ban calls
mklinked "$OUT/api-linked"
with_fake_api linked env -u GITHUB_TOKEN -u GH_TOKEN -u SUPABASE_ACCESS_TOKEN "${S1ENV[@]}" SUPABASE_DB_PASSWORD="$PWU" bash -c "cd '$OUT/api-linked' && '$GOBIN' db push --linked --dry-run > '$OUT/api-linked.log' 2>&1; echo \$? > '$OUT/api-linked.rc'"
say "RESULT db push --linked --dry-run (password, no token) exit=$(cat "$OUT/api-linked.rc"); requests: $(nflows linked)"; flows linked | tee -a "$RES"; say "   log: $(tr '\n' ' ' < "$OUT/api-linked.log" | cut -c1-300)"
expect "(H6b) db push --linked WITH a password and NO token makes no login-role / ban / any HTTP request" "$([ "$(nflows linked)" = 0 ] && echo 0 || echo 1)" "requests=$(nflows linked) exit=$(cat "$OUT/api-linked.rc")"
# 3. db query --linked -o json -f file (the window reads). HON66-PROOF M9/H6c: the reads carry a FIXED NON-SECRET placeholder as the database
# password and NO real one. Variants of how the direct host resolves x which pooler user the linked dir names, to find a path where the CLI's
# pre-run succeeds on this IPv4-only runner; each variant records exit, requests and the Supavisor authentication failures it caused.
PLACEHOLDER="hone-read-placeholder-not-a-secret"
echo "select 1 as one" > "$OUT/api-q.sql"
authfails() { docker logs "$POOLER" 2>&1 | grep -ci 'password authentication failed' ; }
# SOURCE FINDING (HON66-PROOF-3, supabase/cli v2.102.0 apps/cli-go): cmd/root.go:118 runs flags.ParseDatabaseConfig for every command, so
# `db query --linked` first runs NewDbConfigWithPassword (internal/utils/flags/db_url.go:92-157): a 5 s TCP DIAL of db.<ref>.<project-host>:5432
# (L105-109). Only when the dial FAILS does it try the pooler (utils/connect.go:65-98), and GetPoolerConfig returns nil unless the pooler host's
# eTLD+1 equals the profile's pooler_host (connect.go:115-123, `supabase.com`); a local/IP pooler host never qualifies, which is why every
# earlier variant ended in "IPv6 is not supported". With the dial succeeding and SUPABASE_DB_PASSWORD set, no API login-role call is made
# (db_url.go:149-151); RunLinked (internal/db/query/query.go:83-94) then uses only the Management API and never reads DbConfig.
# So the test is a REACHABLE direct host: a local listener on 5432 that records the bytes each connection sends (a login would send a startup packet).
LISTLOG="$OUT/h6c-listener.log"; : > "$LISTLOG"
python3 -I - "$LISTLOG" > /dev/null 2>&1 <<'PYL' &
import socket, sys, threading
log = open(sys.argv[1], "a", buffering=1)
def serve(fam, addr):
    try:
        s = socket.socket(fam, socket.SOCK_STREAM); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(addr); s.listen(16)
    except OSError as e:
        log.write("bind-failed %s %s\n" % (addr[0], e)); return
    while True:
        c, _ = s.accept(); c.settimeout(1.0); n = 0
        try:
            while True:
                b = c.recv(4096)
                if not b: break
                n += len(b)
        except OSError:
            pass
        log.write("conn %s bytes=%d\n" % (addr[0], n)); c.close()
for fam, addr in ((socket.AF_INET, ("127.0.0.1", 5432)), (socket.AF_INET6, ("::1", 5432, 0, 0))):
    threading.Thread(target=serve, args=(fam, addr), daemon=True).start()
threading.Event().wait()
PYL
H6C_LISTENER=$!; sleep 1
H6C_OK=""; H6C_VARIANTS=0
for hv in "aaaa:2001:db8::1" "a4:127.0.0.1" "lo6:::1"; do
  for uv in "fake:postgres.$FAKEREF" "tenant:$PUSER"; do
    L="$(printf "\\x$(printf '%x' $((97 + H6C_VARIANTS)))")"; R="$(printf '%020d' 0 | tr 0 "$L")"
    echo "${hv#*:} db.$R.supabase.co" | sudo tee -a /etc/hosts > /dev/null
    LD="$OUT/api-linked-$R"; rm -rf "$LD"; mkdir -p "$LD/supabase/.temp"; printf '%s\n' "$R" > "$LD/supabase/.temp/project-ref"
    printf '%s' "postgresql://${uv#*:}@$RUNNER_IP:$TLSP/postgres" > "$LD/supabase/.temp/pooler-url"; cp "$OUT/cli-latest" "$LD/supabase/.temp/cli-latest"
    AF0="$(authfails)"; LB0="$(wc -l < "$LISTLOG")"
    with_fake_api "q$H6C_VARIANTS" env -u GITHUB_TOKEN -u GH_TOKEN "${S1ENV[@]}" SUPABASE_ACCESS_TOKEN="$FAKETOKEN" SUPABASE_DB_PASSWORD="$PLACEHOLDER" bash -c "cd '$LD' && '$GOBIN' --agent no db query --linked -o json -f '$OUT/api-q.sql' > '$LD/out' 2> '$LD/err'; echo \$? > '$LD/rc'"
    AF1="$(authfails)"; LB1="$(wc -l < "$LISTLOG")"; LBYTES="$(tail -n +"$((LB0 + 1))" "$LISTLOG" | grep -c 'bytes=[1-9]')"
    P=$(grep -c '"method": "POST", "host": "api.supabase.com", "path": "/v1/projects/'$R'/database/query"' "$OUT/flows-q$H6C_VARIANTS.jsonl")
    O=$(grep -v '"/v1/projects/'$R'/database/query"' "$OUT/flows-q$H6C_VARIANTS.jsonl" | grep -vc '"method": "GET", "host": "api.supabase.com", "path": "/v1/projects/'$R'"')
    say "RESULT H6c variant host=${hv%%:*} user=${uv%%:*}: exit=$(cat "$LD/rc") POST=$P other=$O total=$(nflows "q$H6C_VARIANTS") supavisor_auth_failures_caused=$((AF1 - AF0)) (informational: Supavisor logs its own 28P01 noise) listener_connections=$((LB1 - LB0)) listener_connections_with_bytes=$LBYTES; stdout=$(head -c 80 "$LD/out" | tr -d '\n '); stderr=$(tr '\n' ' ' < "$LD/err" | sed -e "s/$FAKETOKEN/<canary-token>/g" -e "s/$PLACEHOLDER/<placeholder>/g" | cut -c1-200)"
    [ "$O" = 0 ] || H6C_OTHER=1
    [ "$(cat "$LD/rc")" = 0 ] && [ "$P" = 1 ] && [ "$O" = 0 ] && [ "$LBYTES" = 0 ] && [ -z "$H6C_OK" ] && H6C_OK="host=${hv%%:*} user=${uv%%:*}"
    H6C_VARIANTS=$((H6C_VARIANTS + 1))
  done
done
kill "$H6C_LISTENER" 2> /dev/null; wait "$H6C_LISTENER" 2> /dev/null
expect "(H6c-a) in NO variant did db query --linked send anything beyond POST /database/query and the optional GET /v1/projects/<ref> (no read-only endpoint, no login-role, ban, restore or migrations call)" "$([ -z "${H6C_OTHER:-}" ] && echo 0 || echo 1)" "variants=$H6C_VARIANTS"
expect "(H6c-b) PROOF: some variant ran db query --linked with the non-secret placeholder to exit 0, exactly one POST /database/query, nothing else, and NO byte was ever sent to the database host it dialled (the password is not used to log in; a login would send a startup packet)" "$([ -n "$H6C_OK" ] && echo 0 || echo 1)" "${H6C_OK:-none}"
# 4. backups list
mklinked "$OUT/api-linked"
with_fake_api backups env -u GITHUB_TOKEN -u GH_TOKEN "${S1ENV[@]}" SUPABASE_ACCESS_TOKEN="$FAKETOKEN" bash -c "cd '$OUT/api-linked' && '$GOBIN' --agent no backups list --project-ref $FAKEREF -o json > '$OUT/api-backups.out' 2> '$OUT/api-backups.err'; echo \$? > '$OUT/api-backups.rc'"
say "RESULT backups list exit=$(cat "$OUT/api-backups.rc"); requests: $(nflows backups)"; flows backups | tee -a "$RES"
BGET=$(grep -c '"method": "GET", "host": "api.supabase.com", "path": "/v1/projects/'$FAKEREF'/database/backups"' "$OUT/flows-backups.jsonl")
BOTHER=$(grep -v '/database/backups"' "$OUT/flows-backups.jsonl" | grep -vc '"method": "GET", "host": "api.supabase.com", "path": "/v1/projects/'$FAKEREF'"')
expect "(H6d) backups list sends exactly one GET /database/backups (plus at most the optional GET project)" "$([ "$BGET" = 1 ] && [ "$BOTHER" = 0 ] && echo 0 || echo 1)" "get=$BGET other=$BOTHER"
ALLF=$(cat "$OUT"/flows-*.jsonl)
expect "(H6e) no command sent anything to /restore-point, /restore-pitr, /cli/login-role, /network_bans, /database/query/read-only or /migrations" "$(printf '%s' "$ALLF" | grep -qE 'restore-point|restore-pitr|login-role|network_bans|network-bans|query/read-only|/migrations' && echo 1 || echo 0)" "total requests over all steps: $(printf '%s\n' "$ALLF" | grep -c .)"
expect "(H6f) the canary token never reached the database or a log: absent from the db-push logs" "$(grep -qF "$FAKETOKEN" "$OUT/api-push-real.log" "$OUT/api-push-dry.log" 2>/dev/null && echo 1 || echo 0)" "-"
clean_hon66
