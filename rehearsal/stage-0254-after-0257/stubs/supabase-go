#!/bin/bash
# TEST STUB of supabase-go (CI only): behaviour comes from $HOME/stubcfg (key=value), never from the environment. Logs every call to $HOME/calls.log.
H=$HOME; CFG=$H/stubcfg
cfg() { sed -n "s/^$1=//p" "$CFG" 2>/dev/null | head -1; }
CANARY_TOK=canary-token-4f1c; CANARY_PW=canary-pw-9d2e
args="$*"
case "$args" in *"$CANARY_PW"*|*"$CANARY_TOK"*) echo "LEAK argv" >> "$H/leak.log" ;; esac
hang() { : > "$H/$1"; i=0; while [ $i -lt 300 ]; do sleep 0.2; i=$((i+1)); done; exit 9; }
if [ "${1:-}" = --agent ] && [ "${4:-}" = query ]; then # the runner's call: --agent no db query --linked -o json -f FILE
  f=""; while [ $# -gt 0 ]; do [ "$1" = -f ] && f=$2; shift; done
  b=$(basename "$f" .sql)
  printf 'query:%s sql=%s\n' "$b" "$(shasum -a 256 "$f" | cut -d' ' -f1)" >> "$H/calls.log"
  if [ "${SUPABASE_ACCESS_TOKEN:-}" != "$CANARY_TOK" ] || [ "${SUPABASE_DB_PASSWORD:-}" != "$CANARY_PW" ]; then echo "401 unauthorized" >&2; exit 1; fi
  [ "$(cfg READ_AUTH)" = fail ] && { echo "failed to connect: SASL auth failed (28P01)" >&2; exit 1; }
  [ "$(cfg QUERY_HANG)" = "$b" ] && hang query-started
  [ "$(cfg FAIL)" = "$b" ] && { echo "ERROR: relation does not exist (42P01)" >&2; exit 1; }
  v=$(cfg "V_$b")
  case "$b" in
    g02-history-0254a)
      case "$v" in count246) echo '[{"applied_count":246,"hosted_max":"0257","versions_ge_0249":1,"rows_0257":1,"rows_0254":0,"versions_0249_0256":0,"rows_0248":1,"last4":"0257,0248,0246,0245"}]' ;;
        max0258) echo '[{"applied_count":247,"hosted_max":"0258","versions_ge_0249":2,"rows_0257":1,"rows_0254":0,"versions_0249_0256":0,"rows_0248":1,"last4":"0258,0257,0248,0246"}]' ;;
        max0248) echo '[{"applied_count":246,"hosted_max":"0248","versions_ge_0249":0,"rows_0257":0,"rows_0254":0,"versions_0249_0256":0,"rows_0248":1,"last4":"0248,0246,0245,0244"}]' ;;
        ge2) echo '[{"applied_count":247,"hosted_max":"0257","versions_ge_0249":2,"rows_0257":1,"rows_0254":0,"versions_0249_0256":0,"rows_0248":1,"last4":"0257,0248,0246,0245"}]' ;;
        applied) echo '[{"applied_count":248,"hosted_max":"0257","versions_ge_0249":2,"rows_0257":1,"rows_0254":1,"versions_0249_0256":1,"rows_0248":1,"last4":"0257,0254,0248,0246"}]' ;;
        held) echo '[{"applied_count":248,"hosted_max":"0257","versions_ge_0249":2,"rows_0257":1,"rows_0254":0,"versions_0249_0256":1,"rows_0248":1,"last4":"0257,0252,0248,0246"}]' ;;
        *) echo '[{"applied_count":"247","hosted_max":"0257","versions_ge_0249":"1","rows_0257":1,"rows_0254":0,"versions_0249_0256":"0","rows_0248":1,"last4":"0257,0248,0246,0245"}]' ;; esac ;;
    g12-0254a-preflight-0254a)
      case "$v" in bad) echo '[{"at_hosted_0257":1,"tables_present":false,"helpers_ok":true,"replaced_ok":true,"new_objects_absent":true,"columns_ok":true}]' ;;
        newobj) echo '[{"at_hosted_0257":1,"tables_present":true,"helpers_ok":true,"replaced_ok":true,"new_objects_absent":false,"columns_ok":true}]' ;;
        *) echo '[{"at_hosted_0257":1,"tables_present":true,"helpers_ok":true,"replaced_ok":true,"new_objects_absent":true,"columns_ok":true}]' ;; esac ;;
    s1-open-transactions-0254a)
      t="appointment_settlements client_pinned_notes client_pricing manual_fee_charge_attempts payment_charge_attempts"
      n=0; printf '['; for x in $t; do n=$((n+1))
        o=0; [ "$v" = old ] && [ $n = 3 ] && o=1
        p=true; [ "$v" = absent ] && [ $n = 4 ] && p=false
        [ "$v" = four ] && [ $n = 5 ] && continue
        [ $n -gt 1 ] && printf ','; printf '{"at_hosted_0257":1,"table_name":"%s","table_present":%s,"old_xact_backends":%s,"old_idle_in_xact_backends":0,"waiting_backends":0,"any_xact_backends":0,"oldest_xact_age_seconds":0,"old_xact_backends_database_wide":0}' "$x" "$p" "$o"; done; echo ']' ;;
    w03-table-sizes-0254a)
      st=$(cfg ST); [ -n "$st" ] || st=2min
      t="appointment_settlements client_pinned_notes client_pricing manual_fee_charge_attempts payment_charge_attempts"
      n=0; printf '['; for x in $t; do n=$((n+1)); s=$st; [ "$v" = mixed ] && [ $n = 5 ] && s=30s
        b2=1048576; [ "$v" = big ] && [ $n = 2 ] && b2=629145600
        [ $n -gt 1 ] && printf ','; printf '{"at_hosted_0257":1,"table_name":"%s","present":true,"total_bytes":%s,"approx_rows":10,"statement_timeout":"%s","lock_timeout":"0"}' "$x" "$b2" "$s"; done; echo ']' ;;
    *) echo "unknown query $b" >&2; exit 1 ;;
  esac
  exit 0
fi
if [ "${1:-}" = db ] && [ "${2:-}" = push ]; then
  mode=push; case "$args" in *--dry-run*) mode=dry ;; esac
  ia=no; case "$args" in *--include-all*) ia=yes ;; esac
  # a PLAIN push or dry run is what the real CLI refuses for a file below the remote max: log it as such and refuse
  if [ $ia = no ]; then printf '%s\n' "$mode-plain" >> "$H/calls.log"; echo "Found local migration files to be inserted before the last migration on remote database." >&2; echo "Rerun the command with --include-all flag to apply these migrations:" >&2; exit 1; fi
  printf '%s\n' "$mode" >> "$H/calls.log"
  [ -z "${SUPABASE_ACCESS_TOKEN:-}" ] || echo "LEAK token-in-env $mode" >> "$H/leak.log"
  [ "${PGPASSWORD:-}" = "$CANARY_PW" ] || { echo "password authentication failed (28P01)" >&2; exit 1; }
  if [ "$mode" = dry ]; then
    case "$(cfg DRY)" in authfail) echo "failed SASL auth: password authentication failed (28P01)" >&2; exit 1 ;; esac
    echo 'DRY RUN: migrations will *not* be pushed to the database.'; echo 'Would push these migrations:'
    case "$(cfg DRY)" in two) echo ' • 0254_perm_hon44_role_enforcement.sql'; echo ' • 0249_x.sql' ;; wrong) echo ' • 0247_x.sql' ;; *) echo ' • 0254_perm_hon44_role_enforcement.sql' ;; esac
    exit 0
  fi
  case "$(cfg PUSH)" in
    authfail) echo "failed SASL auth: password authentication failed (28P01)" >&2; exit 1 ;;
    fail) echo "ERROR: statement failed (XX000)" >&2; exit 1 ;;
    killed) echo "Applying migration 0254_perm_hon44_role_enforcement.sql..."; kill -9 $$ ;;
    hang) echo "Applying migration 0254_perm_hon44_role_enforcement.sql..."; hang push-started ;;
    two) echo "Applying migration 0254_perm_hon44_role_enforcement.sql..."; echo "Applying migration 0249_x.sql..."; echo "Finished supabase db push."; exit 0 ;;
    nofinish) echo "Applying migration 0254_perm_hon44_role_enforcement.sql..."; exit 0 ;;
    *) echo "Applying migration 0254_perm_hon44_role_enforcement.sql..."; echo "Finished supabase db push."; exit 0 ;;
  esac
fi
echo "stub: unexpected call: $args" >&2; echo "UNEXPECTED $args" >> "$H/leak.log"; exit 2
