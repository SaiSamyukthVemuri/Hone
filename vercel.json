{
  "crons": [
    {
      "path": "/api/cron/materialize-recurring-breaks",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/calendar-reconcile",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "30 9 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "Vary"
          },
          "args": "Accept"
        }
      ]
    },
    {
      "src": "^/(about|contact)/?$",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "Vary"
          },
          "args": "Accept"
        }
      ]
    }
  ]
}
