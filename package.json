{
  "name": "hone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-production-env-gates.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:payment": "playwright test --config playwright.payment.config.ts",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:e2e:google": "playwright test --config playwright.google.config.ts",
    "e2e:google-server": "next build && next start",
    "e2e:server": "next build && next start",
    "e2e:payment-server": "next build && next start",
    "check:stripe-gates": "node scripts/check-stripe-gates.mjs",
    "check:migration-extensions": "node scripts/check-migration-extension-qualification.mjs",
    "check:fresh-managed": "node scripts/check-fresh-managed-extensions.mjs",
    "check:db-types": "node scripts/check-db-types.mjs",
    "check:prod-env-gates": "node scripts/check-production-env-gates.mjs",
    "ci": "npm run typecheck && npm run lint && npm run build && npm test && npm run check:stripe-gates && npm run check:migration-extensions",
    "verify:prepush": "node scripts/verify-prepush.mjs",
    "migration:state": "node scripts/migration-state.mjs",
    "ci:classify": "node scripts/classify-changes.mjs",
    "ci:plan": "node scripts/ci-plan.mjs",
    "verify:changed": "node scripts/verify-changed.mjs",
    "e2e:resources": "node scripts/worktree-resources.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.66.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jszip": "^3.10.1",
    "next": "15.5.22",
    "posthog-js": "^1.404.1",
    "posthog-node": "^5.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.22",
    "pg": "^8.21.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
