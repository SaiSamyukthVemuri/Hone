# ============================================================================
# Hone environment variables
# ============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to the repo.

# ----------------------------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------------------------
# From: https://supabase.com/dashboard - your project - Settings - API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key for admin operations (cron, trigger functions).
# Never expose to the client. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# App origin (REQUIRED in production)
# ----------------------------------------------------------------------------
# Used to build cancel/reschedule/manage/intake URLs in outgoing emails,
# SMS messages, and cron-generated reminders.
#
# Resolution (see lib/app-origin.ts):
#   1. NEXT_PUBLIC_APP_ORIGIN if set (production wins on this).
#   2. VERCEL_URL on Preview deployments (per-deploy URL, not production).
#   3. http://localhost:3000 only when NODE_ENV !== "production".
#   4. Throws in production if none of the above. No silent fallback to
#      https://hone.care; a missing env in prod is a config error that
#      must fail closed rather than mail wrong-domain links to clients.
#
# Production should always point to https://hone.care, never a preview URL.
NEXT_PUBLIC_APP_ORIGIN=https://hone.care

# ----------------------------------------------------------------------------
# Email delivery via Resend (required for email features)
# ----------------------------------------------------------------------------
# From: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# ----------------------------------------------------------------------------
# Cron authentication (required for cron endpoints to work)
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Used by /api/cron/* endpoints to authenticate scheduled requests
# from cron-job.org or other external schedulers.
CRON_SECRET=your-32-byte-hex-secret-here

# ----------------------------------------------------------------------------
# Token signing secrets (required)
# ----------------------------------------------------------------------------
# Used to sign URL tokens for appointment cancellation/reschedule links
# and intake form completion links. Rotate carefully (invalidates in-flight
# tokens). Generate each with: openssl rand -hex 32
#
# Both are REQUIRED and have no fallback: the token code throws server-side
# if its secret is missing (the previous APPOINTMENT_SIGNING_SECRET ->
# SUPABASE_SERVICE_ROLE_KEY fallback has been removed). Set each in every
# environment before deploying.
APPOINTMENT_SIGNING_SECRET=your-32-byte-hex-secret-here
INTAKE_SIGNING_SECRET=your-32-byte-hex-secret-here

# ----------------------------------------------------------------------------
# Admin portal allowlist (REQUIRED in production)
# ----------------------------------------------------------------------------
# Comma-separated list of emails granted access to the /admin portal.
# Entries are trimmed, lowercased, and empties ignored. Example:
#   ADMIN_EMAILS=samyukth.ssv@gmail.com,other@example.com
#
# Production behavior (PR #143):
#   * NODE_ENV === "production" with no ADMIN_EMAILS set: isAdmin() returns
#     false for everyone. /admin redirects to /dashboard. No hardcoded
#     fallback grants admin in production.
#   * A sanitized server-side log fires once per process when the env is
#     missing in production so the operator notices.
#
# Non-production (local dev): the built-in default in lib/admin.ts is used
# when this is unset so /admin keeps working without a per-developer .env.
ADMIN_EMAILS=samyukth.ssv@gmail.com

# ----------------------------------------------------------------------------
# Portal fingerprint salt (REQUIRED in production for diagnostics)
# ----------------------------------------------------------------------------
# Used by lib/portal/tokens.ts:hashFingerprint() to salt SHA-256 hashes of
# IP, user-agent, and email values written to magic-link and consent-
# signature rows for operator audit. Generate with: openssl rand -hex 32
#
# These hashes are DIAGNOSTIC ONLY. Portal authentication uses the raw
# magic-link token -> hashToken pair (independent of this salt). The
# DB columns are nullable; a missing salt does not break portal login,
# magic-link issuance, or consent capture.
#
# Production behavior (PR #143):
#   * NODE_ENV === "production" with no PORTAL_FINGERPRINT_SALT set:
#     hashFingerprint() returns null. The diagnostic columns store null.
#     No project-known/predictable salt is ever used to hash a real
#     client's IP or UA, so a leaked DB yields no usable reverse-lookup.
#   * A sanitized server-side log fires once per process when the env
#     is missing in production.
#
# Non-production: a stable dev fallback is used so the hash code path
# still runs in tests and local development without an .env entry.
PORTAL_FINGERPRINT_SALT=your-32-byte-hex-secret-here

# ----------------------------------------------------------------------------
# Ops alert email allowlist (optional)
# ----------------------------------------------------------------------------
# Comma-separated emails that should receive operator notifications for
# CRITICAL ops alerts (manual fee charge needs_manual_review, Stripe
# webhook processing failure, card-on-file setup failure, cron route
# failure). PR #153 introduced the ops_alerts table; the recordOpsAlert
# helper writes a durable row + a structured stderr log on every call,
# and ADDITIONALLY emails this allowlist when severity is critical.
#
# Behavior:
#   * Unset -> no operator emails are sent. Alerts still land in
#     ops_alerts + Vercel logs. Fail-closed by design.
#   * Set to one or more comma-separated addresses -> Resend sends a
#     plain-text body with safe identifiers ONLY (no tokens, no card
#     data, no client_secret, no raw Stripe payload).
#   * Events whose name starts with "email_" are NEVER emailed to
#     prevent a "email send failed -> alert -> email send failed" loop.
#
# Example: OPS_ALERT_EMAILS=samyukth.ssv@gmail.com
OPS_ALERT_EMAILS=

# ----------------------------------------------------------------------------
# Stripe Connect — Phase 1 (onboarding + status only)
# ----------------------------------------------------------------------------
#
# IMPORTANT POLICY: Phase 1 is TEST MODE BY DEFAULT IN EVERY
# ENVIRONMENT, INCLUDING VERCEL PRODUCTION. Live mode is disabled
# behind an explicit opt-in flag (STRIPE_ALLOW_LIVE_MODE) that this
# branch deliberately does NOT set. Flipping the flag must go through
# a separate live-mode-enablement review.
#
# Vercel Preview and Development deployments MUST use sk_test_ keys
# regardless of STRIPE_ALLOW_LIVE_MODE. The server enforces this in
# lib/stripe/server.ts and throws if a live key is presented in those
# environments.

# Server-only Stripe secret key.
# Allowed:
#   * sk_test_*  — accepted everywhere.
#   * sk_live_*  — accepted only when STRIPE_ALLOW_LIVE_MODE=true AND
#                  VERCEL_ENV is not preview/development. Phase 1 leaves
#                  STRIPE_ALLOW_LIVE_MODE unset, so live keys throw.
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Live-mode gate. Leave UNSET (or "false") for Phase 1. Setting this
# to "true" without a separate live-mode-enablement review is a P0
# violation. The server in lib/stripe/server.ts refuses to instantiate
# Stripe with sk_live_ unless this is exactly "true".
STRIPE_ALLOW_LIVE_MODE=false

# Stripe webhook signing secret from the webhook endpoint configured in
# the Stripe dashboard. Used by stripe.webhooks.constructEvent.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public Stripe publishable key (PR #135 card-on-file Phase 1).
# Allowed:
#   * pk_test_*  - accepted everywhere.
#   * pk_live_*  - accepted only when STRIPE_ALLOW_LIVE_MODE=true AND
#                  VERCEL_ENV is not preview/development. Mirrors the
#                  secret-key gate in lib/stripe/server.ts.
# Required for the portal Add card surface to render Stripe Elements.
# Missing or invalid: portal shows a calm unavailable message and
# does NOT crash. Never logged. Test-mode value (pk_test_*) is the
# only safe choice while STRIPE_ALLOW_LIVE_MODE is unset/false.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Connect country for Express account creation. Hardcoded CA for the
# current Canadian rollout; override per environment if needed. Phase 1
# does not have per-studio country yet.
STRIPE_CONNECT_COUNTRY=CA

# ----------------------------------------------------------------------------
# Public booking rate limiting via Upstash Redis (optional)
# ----------------------------------------------------------------------------
# Used by lib/rate-limit/public.ts to rate-limit the unauthenticated public
# booking surfaces (slot fetch + booking submit). REST flavor — works on
# Vercel Fluid/serverless without a TCP connection.
#
# OPTIONAL and FAIL-OPEN: if either var is unset (e.g. local dev), the
# limiter is disabled and all requests are allowed. If the backend errors at
# runtime, requests are also allowed (a limiter outage must never block a
# real booking). Identifiers are hashed before use; no raw IPs/emails are
# stored. From: https://console.upstash.com (Redis database - REST API).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# ----------------------------------------------------------------------------
# Twilio SMS (optional, OFF by default)
# ----------------------------------------------------------------------------
# Used by lib/sms/* for transactional SMS confirmations and reminders. SMS
# is fully gated:
#   * If TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are missing, the SMS helper
#     returns ok:false and the booking/reminder paths log a clean failure
#     and move on; nothing throws.
#   * The studios.send_*_sms toggles default false; SMS only sends after a
#     studio operator flips the toggle by SQL.
#   * The client must have an explicit sms_consent_at and no sms_opted_out_at.
#
# From: https://console.twilio.com/ . Account SID + Auth Token. Use either
# TWILIO_MESSAGING_SERVICE_SID (preferred when available) or
# TWILIO_FROM_NUMBER (a verified Twilio sending number in E.164 format).
# If both are set, MessagingServiceSid wins.
#
# TWILIO_WEBHOOK_BASE_URL is the public origin Twilio POSTs the inbound STOP
# webhook to (https://hone.care in production). Used by the signature
# validator to build the canonical signed URL. Falls back to request.url
# when unset, which is fine in production behind a single hostname but
# brittle behind preview-deploy URLs.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15555555555
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_BASE_URL=https://hone.care
