# ============================================================================
# Hone environment variables
# ============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to the repo.

# ----------------------------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------------------------
# From: https://supabase.com/dashboard - your project - Settings - API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key for admin operations (cron, trigger functions).
# Never expose to the client. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# App origin (required)
# ----------------------------------------------------------------------------
# Used to build cancel/reschedule/intake URLs in outgoing emails.
# Production should always point to https://hone.care, never a preview URL.
NEXT_PUBLIC_APP_ORIGIN=https://hone.care

# ----------------------------------------------------------------------------
# Email delivery via Resend (required for email features)
# ----------------------------------------------------------------------------
# From: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# ----------------------------------------------------------------------------
# Cron authentication (required for cron endpoints to work)
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Used by /api/cron/* endpoints to authenticate scheduled requests
# from cron-job.org or other external schedulers.
CRON_SECRET=your-32-byte-hex-secret-here

# ----------------------------------------------------------------------------
# Token signing secrets (required)
# ----------------------------------------------------------------------------
# Used to sign URL tokens for appointment cancellation/reschedule links
# and intake form completion links. Rotate carefully (invalidates in-flight
# tokens). Generate each with: openssl rand -hex 32
#
# Both are REQUIRED and have no fallback: the token code throws server-side
# if its secret is missing (the previous APPOINTMENT_SIGNING_SECRET ->
# SUPABASE_SERVICE_ROLE_KEY fallback has been removed). Set each in every
# environment before deploying.
APPOINTMENT_SIGNING_SECRET=your-32-byte-hex-secret-here
INTAKE_SIGNING_SECRET=your-32-byte-hex-secret-here

# ----------------------------------------------------------------------------
# Admin portal allowlist (optional)
# ----------------------------------------------------------------------------
# Comma-separated list of emails granted access to the /admin portal.
# Entries are trimmed, lowercased, and empties ignored. When unset/empty,
# the built-in default in lib/admin.ts is used, so admin access keeps
# working before this is set. Example:
#   ADMIN_EMAILS=samyukth.ssv@gmail.com,other@example.com
ADMIN_EMAILS=samyukth.ssv@gmail.com

# ----------------------------------------------------------------------------
# Stripe Connect — Phase 1 (onboarding + status only)
# ----------------------------------------------------------------------------
#
# IMPORTANT POLICY: Phase 1 is TEST MODE BY DEFAULT IN EVERY
# ENVIRONMENT, INCLUDING VERCEL PRODUCTION. Live mode is disabled
# behind an explicit opt-in flag (STRIPE_ALLOW_LIVE_MODE) that this
# branch deliberately does NOT set. Flipping the flag must go through
# a separate live-mode-enablement review.
#
# Vercel Preview and Development deployments MUST use sk_test_ keys
# regardless of STRIPE_ALLOW_LIVE_MODE. The server enforces this in
# lib/stripe/server.ts and throws if a live key is presented in those
# environments.

# Server-only Stripe secret key.
# Allowed:
#   * sk_test_*  — accepted everywhere.
#   * sk_live_*  — accepted only when STRIPE_ALLOW_LIVE_MODE=true AND
#                  VERCEL_ENV is not preview/development. Phase 1 leaves
#                  STRIPE_ALLOW_LIVE_MODE unset, so live keys throw.
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Live-mode gate. Leave UNSET (or "false") for Phase 1. Setting this
# to "true" without a separate live-mode-enablement review is a P0
# violation. The server in lib/stripe/server.ts refuses to instantiate
# Stripe with sk_live_ unless this is exactly "true".
STRIPE_ALLOW_LIVE_MODE=false

# Stripe webhook signing secret from the webhook endpoint configured in
# the Stripe dashboard. Used by stripe.webhooks.constructEvent.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Connect country for Express account creation. Hardcoded CA for the
# current Canadian rollout; override per environment if needed. Phase 1
# does not have per-studio country yet.
STRIPE_CONNECT_COUNTRY=CA

# ----------------------------------------------------------------------------
# Public booking rate limiting via Upstash Redis (optional)
# ----------------------------------------------------------------------------
# Used by lib/rate-limit/public.ts to rate-limit the unauthenticated public
# booking surfaces (slot fetch + booking submit). REST flavor — works on
# Vercel Fluid/serverless without a TCP connection.
#
# OPTIONAL and FAIL-OPEN: if either var is unset (e.g. local dev), the
# limiter is disabled and all requests are allowed. If the backend errors at
# runtime, requests are also allowed (a limiter outage must never block a
# real booking). Identifiers are hashed before use; no raw IPs/emails are
# stored. From: https://console.upstash.com (Redis database - REST API).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here
