    {
      "id": "claim_c255fb79594f4edf93d757c344bba682",
      "statement": "Migration 0204 adds studios.new_client_admission_mode as a non-null column defaulting to open with a check limiting it to open, waitlist or closed, plus set_at and set_by audit columns that deliberately carry no foreign key to avoid ambiguous PostgREST embeds.",
      "evidence": [
        {
